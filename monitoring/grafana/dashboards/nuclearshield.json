{
  "annotations": {"list": []},
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "text",
      "title": "NUCLEARSHIELD // CYBER DEFENSE COMMAND VIEW",
      "gridPos": {"h": 4, "w": 24, "x": 0, "y": 0},
      "options": {
        "mode": "markdown",
        "content": "# ⚛ NUCLEARSHIELD · CYBER DEFENSE COMMAND VIEW\n**LOCAL EVIDENCE • READ-ONLY • SCHEMA-DRIVEN**\n\n`EVIDENCE INGEST` → `SCHEMA PROFILING` → `AI ANOMALY ANALYSIS` → `CROSS-FILE RISK` → `HUMAN REVIEW`"
      }
    },
    {
      "type": "stat",
      "title": "EVIDENCE SOURCES",
      "gridPos": {"h": 5, "w": 4, "x": 0, "y": 4},
      "targets": [{"expr": "nuclearshield_evidence_files", "refId": "A"}],
      "fieldConfig": {"defaults": {"color": {"mode": "fixed", "fixedColor": "blue"}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "textMode": "auto"}
    },
    {
      "type": "stat",
      "title": "RECORDS INDEXED",
      "gridPos": {"h": 5, "w": 5, "x": 4, "y": 4},
      "targets": [{"expr": "nuclearshield_evidence_rows", "refId": "A"}],
      "fieldConfig": {"defaults": {"color": {"mode": "fixed", "fixedColor": "purple"}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center"}
    },
    {
      "type": "stat",
      "title": "CROSS-FILE RISK",
      "gridPos": {"h": 5, "w": 5, "x": 9, "y": 4},
      "targets": [{"expr": "nuclearshield_evidence_risk_score", "refId": "A"}],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 40}, {"color": "orange", "value": 70}, {"color": "red", "value": 85}]}
        },
        "overrides": []
      },
      "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "center"}
    },
    {
      "type": "stat",
      "title": "ANOMALY FLAGS",
      "gridPos": {"h": 5, "w": 5, "x": 14, "y": 4},
      "targets": [{"expr": "sum(nuclearshield_dataset_anomaly_flags)", "refId": "A"}],
      "fieldConfig": {
        "defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "orange", "value": 100}, {"color": "red", "value": 250}]}},
        "overrides": []
      },
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center"}
    },
    {
      "type": "stat",
      "title": "DATA QUALITY",
      "description": "100 minus average missing-data percentage across loaded evidence.",
      "gridPos": {"h": 5, "w": 5, "x": 19, "y": 4},
      "targets": [{"expr": "100 - avg(nuclearshield_dataset_missing_pct)", "refId": "A"}],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "orange", "value": 80}, {"color": "yellow", "value": 90}, {"color": "green", "value": 98}]}
        },
        "overrides": []
      },
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center"}
    },
    {
      "type": "gauge",
      "title": "THREAT / ANOMALY PRESSURE",
      "gridPos": {"h": 9, "w": 8, "x": 0, "y": 9},
      "targets": [{"expr": "nuclearshield_evidence_risk_score", "refId": "A"}],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 40}, {"color": "orange", "value": 70}, {"color": "red", "value": 85}]}
        },
        "overrides": []
      },
      "options": {"showThresholdLabels": true, "showThresholdMarkers": true}
    },
    {
      "type": "bargauge",
      "title": "DOMAIN RISK // EVIDENCE SOURCES",
      "gridPos": {"h": 9, "w": 8, "x": 8, "y": 9},
      "targets": [{"expr": "nuclearshield_dataset_anomaly_score", "legendFormat": "{{domain}} · {{file}}", "refId": "A"}],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 40}, {"color": "orange", "value": 70}, {"color": "red", "value": 85}]}
        },
        "overrides": []
      },
      "options": {"displayMode": "gradient", "orientation": "horizontal", "showUnfilled": true}
    },
    {
      "type": "bargauge",
      "title": "DATA QUALITY // MISSINGNESS",
      "gridPos": {"h": 9, "w": 8, "x": 16, "y": 9},
      "targets": [{"expr": "nuclearshield_dataset_missing_pct", "legendFormat": "{{domain}} · {{file}}", "refId": "A"}],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 2}, {"color": "orange", "value": 10}, {"color": "red", "value": 25}]}
        },
        "overrides": []
      },
      "options": {"displayMode": "gradient", "orientation": "horizontal", "showUnfilled": true}
    },
    {
      "type": "timeseries",
      "title": "LIVE EVIDENCE TELEMETRY // DISCOVERED NUMERIC FEATURES",
      "description": "Series are created only from numeric fields actually discovered in loaded evidence. No fixed facility telemetry is fabricated.",
      "gridPos": {"h": 11, "w": 16, "x": 0, "y": 18},
      "targets": [{"expr": "nuclearshield_feature_latest_value", "legendFormat": "{{domain}} · {{feature}}", "refId": "A"}],
      "fieldConfig": {
        "defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 12, "gradientMode": "opacity", "showPoints": "auto", "spanNulls": true}},
        "overrides": []
      },
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "min", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "type": "timeseries",
      "title": "AI ANOMALY PRESSURE // BY DOMAIN",
      "gridPos": {"h": 11, "w": 8, "x": 16, "y": 18},
      "targets": [{"expr": "nuclearshield_dataset_anomaly_score", "legendFormat": "{{domain}}", "refId": "A"}],
      "fieldConfig": {
        "defaults": {"unit": "percent", "min": 0, "max": 100, "color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 3, "fillOpacity": 20, "gradientMode": "opacity", "showPoints": "never"}},
        "overrides": []
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "type": "table",
      "title": "EVIDENCE INVENTORY // ACTIVE ANALYSIS SET",
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 29},
      "targets": [{"expr": "nuclearshield_dataset_rows", "legendFormat": "{{file}} · {{domain}}", "refId": "A", "instant": true}],
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}}, "overrides": []},
      "options": {"showHeader": true, "cellHeight": "sm"}
    },
    {
      "type": "bargauge",
      "title": "AI MODEL FLAGS // BY EVIDENCE SOURCE",
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 29},
      "targets": [{"expr": "nuclearshield_dataset_anomaly_flags", "legendFormat": "{{domain}} · {{file}}", "refId": "A"}],
      "fieldConfig": {
